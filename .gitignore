# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.ipynb_checkpoints/

# ── Virtual environments ────────────────────────────────────
.venv/
venv/
env/

# ── Runtime data / captured traffic (regenerated at runtime) ─
buffers/*.csv
buffers/capture_work/
capture_work/
live_capture/
incoming/
dev_scripts/_work/

# ── Adapted models produced by the app (user-specific) ───────
trained_models/M3_adapted_*/
trained_models/.current

# ── OS / editor cruft ────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# ── Packet captures ──────────────────────────────────────────
*.pcap
*.pcapng
